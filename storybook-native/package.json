{
  "name": "@firna/ui-storybook-native",
  "version": "0.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "STORYBOOK_ENABLED=true expo start",
    "ios": "STORYBOOK_ENABLED=true expo start --ios",
    "android": "STORYBOOK_ENABLED=true expo start --android",
    "ios:dev": "npm --prefix .. run build && STORYBOOK_ENABLED=true expo run:ios",
    "android:dev": "npm --prefix .. run build && STORYBOOK_ENABLED=true expo run:android",
    "storybook:native": "npm --prefix .. run build && npm start -- --clear"
  },
  "dependencies": {
    "@firna/ui": "file:..",
    "@gorhom/bottom-sheet": "^5.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@storybook/addon-ondevice-actions": "^10.0.0",
    "@storybook/addon-ondevice-backgrounds": "^10.0.0",
    "@storybook/addon-ondevice-notes": "^10.0.0",
    "@storybook/react-native": "^10.0.0",
    "expo": "~58.0.26",
    "expo-status-bar": "~58.0.5",
    "lucide-react": "^0.562.0",
    "lucide-react-native": "^0.562.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "storybook": "^10.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
