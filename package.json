  },
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json && node scripts/prepare-node-esm.mjs",
    "clean": "rm -rf dist storybook-static playwright-report test-results",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:browser": "playwright test",
    "test:package": "node scripts/package-smoke.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "verify": "npm run format:check && npm run test && npm run typecheck && npm run build && npm run test:package && npm run storybook:build && npm run test:browser"
  },
  "peerDependencies": {
    "lucide-react-native": ">=0.560.0 <1",
    "react": ">=19 <20",
    "react-dom": ">=19 <20",
    "react-native": ">=0.83 <0.86",
    "react-native-svg": ">=15 <16",
    "react-native-web": ">=0.21 <0.22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/react-vite": "^10.1.6",
    "@types/node": "^25.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "lucide-react-native": "^0.562.0",
    "prettier": "^3.7.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.2",
    "storybook": "^10.1.6",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^7.2.7",
    "wrangler": "^4.56.1"
  }
