{
  "name": "@firna/ui",
  "version": "0.7.0",
  "description": "Shared React Native and React Native Web UI primitives for Firna apps.",
  "private": false,
  "type": "module",
  "packageManager": "npm@11.7.0",
  "license": "MIT",
  "author": "Firna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/futex-ai/ui.git"
  },
  "bugs": {
    "url": "https://github.com/futex-ai/ui/issues"
  },
  "homepage": "https://github.com/futex-ai/ui#readme",
  "keywords": [
    "expo",
    "react",
    "react-native",
    "react-native-web",
    "ui"
  ],
  "main": "./dist/node/index.js",
  "types": "./dist/node/index.d.ts",
  "react-native": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/node/index.js"
    },
    "./animated-border": {
      "types": "./dist/node/animated-border/index.d.ts",
      "react-native": "./dist/animated-border/index.js",
      "import": "./dist/node/animated-border/index.js"
    },
    "./avatar": {
      "types": "./dist/node/avatar/index.d.ts",
      "react-native": "./dist/avatar/index.js",
      "import": "./dist/node/avatar/index.js"
    },
    "./badge": {
